-- Wait for game load
if not game:IsLoaded() then game.Loaded:Wait() end

local Market = game:GetService("MarketplaceService")
local pGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")

-- Cleanup
if pGui:FindFirstChild("MusicTracker") then pGui.MusicTracker:Destroy() end

-- GUI Construction
local sg = Instance.new("ScreenGui")
sg.Name = "MusicTracker"
sg.Parent = pGui
sg.ResetOnSpawn = false

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 280, 0, 350)
frame.Position = UDim2.new(0.5, -140, 0.2, 0)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.fromRGB(255, 0, 0) -- Red border so you can't miss it
frame.Active = true
frame.Draggable = true
frame.Parent = sg

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.Text = "🎵 CLUB ID LOGGER"
title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.SourceSansBold
title.Parent = frame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -10, 1, -50)
scroll.Position = UDim2.new(0, 5, 0, 45)
scroll.BackgroundTransparency = 1
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.Parent = frame

local list = Instance.new("UIListLayout")
list.Parent = scroll
list.Padding = UDim.new(0, 5)

local cache = {}

-- Function to check if ID is Public
local function getPrivacyStatus(id)
    local success, info = pcall(function()
        return Market:GetProductInfo(id)
    end)
    
    if success and info then
        -- If it has a name and creator, it's generally findable. 
        -- If it's blocked by Roblox's 2022 audio update, it returns 'N/A' or errors.
        return info.CanBePurchasedAsAsset == false and "🔴 PRIVATE" or "🟢 PUBLIC"
    end
    return "⚪ UNKNOWN"
end

local function addEntry(name, id)
    if cache[id] then return end
    cache[id] = true
    
    local status = getPrivacyStatus(id)
    
    local entry = Instance.new("Frame")
    entry.Size = UDim2.new(1, -5, 0, 60)
    entry.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    entry.Parent = scroll
    
    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(0.7, 0, 1, 0)
    infoLabel.Text = name .. "\nID: " .. id .. "\nStatus: " .. status
    infoLabel.TextColor3 = Color3.new(1, 1, 1)
    infoLabel.TextScaled = true
    infoLabel.BackgroundTransparency = 1
    infoLabel.Parent = entry
    
    local copy = Instance.new("TextButton")
    copy.Size = UDim2.new(0.25, 0, 0.6, 0)
    copy.Position = UDim2.new(0.72, 0, 0.2, 0)
    copy.Text = "COPY"
    copy.BackgroundColor3 = (status == "🟢 PUBLIC") and Color3.new(0, 0.6, 0) or Color3.new(0.6, 0, 0)
    copy.TextColor3 = Color3.new(1, 1, 1)
    copy.Parent = entry
    
    copy.MouseButton1Click:Connect(function()
        setclipboard(id)
        copy.Text = "SAVED"
        task.wait(0.5)
        copy.Text = "COPY"
    end)
    
    scroll.CanvasSize = UDim2.new(0, 0, 0, list.AbsoluteContentSize.Y)
end

-- Fast Scan Loop
task.spawn(function()
    while task.wait(1) do
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("Sound") and obj.IsPlaying then
                local id = obj.SoundId:match("%d+")
                if id then addEntry(obj.Name, id) end
            end
        end
    end
end)
